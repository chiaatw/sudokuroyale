 {
    "compilerOptions": {
      "target": "ES2020",
      "lib": ["ES2020", "DOM", "DOM.Iterable"],
      "module": "ESNext",
      "types": ["node"],
      "moduleResolution": "Bundler",
      "jsx": "react-jsx",
  
      "strict": true,
      "skipLibCheck": true,
      "noEmit": true,
  
      "baseUrl": ".",
      "paths": {
        "@/*": ["src/*"]
      }
    },
    "include": ["src"]
  }  